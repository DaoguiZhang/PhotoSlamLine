+
+float readFloatAlias(const cv::FileStorage& file, const char* canonical_key,
+                     const char* alias_key, float default_value,
+                     std::string& source)
+{
+    const cv::FileNode canonical = file[canonical_key];
+    const cv::FileNode alias = file[alias_key];
+    const bool has_canonical = !canonical.isNone();
+    const bool has_alias = !alias.isNone();
+    float cv = 0.0f, av = 0.0f;
+    const bool canonical_ok = has_canonical && readFloatNode(canonical, cv);
+    const bool alias_ok = has_alias && readFloatNode(alias, av);
+    if (has_canonical && !canonical_ok)
+    {
+        std::cerr << "[Config][ERROR] " << canonical_key
+                  << " exists but is not numeric\n";
+        std::exit(EXIT_FAILURE);
+    }
+    if (has_alias && !alias_ok)
+    {
+        std::cerr << "[Config][ERROR] " << alias_key
+                  << " exists but is not numeric\n";
+        std::exit(EXIT_FAILURE);
+    }
+    if (has_canonical && has_alias && std::abs(cv - av) > 1e-6f)
+    {
+        std::cerr << "[Config][ERROR] conflicting keys " << canonical_key
+                  << "=" << cv << " and " << alias_key << "=" << av
+                  << "\n";
+        std::exit(EXIT_FAILURE);
+    }
+    if (has_canonical)
+    {
+        source = has_alias ? "canonical (alias same)" : "canonical";
+        std::cerr << "[ConfigAlias] " << canonical_key << '=' << cv
+                  << " source=" << source << '\n';
+        return cv;
+    }
+    if (has_alias)
+    {
+        source = "alias";
+        std::cerr << "[ConfigAlias][WARN] " << canonical_key
+                  << " absent; using alias " << alias_key << '=' << av
+                  << '\n';
+        return av;
+    }
+    source = "explicit_default";
+    std::cerr << "[ConfigAlias][WARN] " << canonical_key << " and "
+              << alias_key << " absent; using explicit default "
+              << default_value << '\n';
+    return default_value;
+}
+
+int readIntAlias(const cv::FileStorage& file, const char* canonical_key,
+                 const char* alias_key, int default_value,
+                 std::string& source)
+{
+    const cv::FileNode canonical = file[canonical_key];
+    const cv::FileNode alias = file[alias_key];
+    const bool has_canonical = !canonical.isNone();
+    const bool has_alias = !alias.isNone();
+    int cv = 0, av = 0;
+    const bool canonical_ok = has_canonical && readIntNode(canonical, cv);
+    const bool alias_ok = has_alias && readIntNode(alias, av);
+    if (has_canonical && !canonical_ok)
+    {
+        std::cerr << "[Config][ERROR] " << canonical_key
+                  << " exists but is not an integer\n";
+        std::exit(EXIT_FAILURE);
+    }
+    if (has_alias && !alias_ok)
+    {
+        std::cerr << "[Config][ERROR] " << alias_key
+                  << " exists but is not an integer\n";
+        std::exit(EXIT_FAILURE);
+    }
+    if (has_canonical && has_alias && cv != av)
+    {
+        std::cerr << "[Config][ERROR] conflicting keys " << canonical_key
+                  << "=" << cv << " and " << alias_key << "=" << av
+                  << "\n";
+        std::exit(EXIT_FAILURE);
+    }
+    if (has_canonical)
+    {
+        source = has_alias ? "canonical (alias same)" : "canonical";
+        std::cerr << "[ConfigAlias] " << canonical_key << '=' << cv
+                  << " source=" << source << '\n';
+        return cv;
+    }
+    if (has_alias)
+    {
+        source = "alias";
+        std::cerr << "[ConfigAlias][WARN] " << canonical_key
+                  << " absent; using alias " << alias_key << '=' << av
+                  << '\n';
+        return av;
+    }
+    source = "explicit_default";
+    std::cerr << "[ConfigAlias][WARN] " << canonical_key << " and "
+              << alias_key << " absent; using explicit default "
+              << default_value << '\n';
+    return default_value;
 }
 
