+// ---------------------------------------------------------------------------
+// Controlled under-training diagnostic at the live natural end.
+//
+// The existing end snapshot does not contain Adam moments or learning rates,
+// so it cannot be resumed offline without silently rebuilding optimizer state.
+// This hook is therefore called while the process still owns the complete
+// in-memory state.  It runs two fixed-topology arms (A and C) from the SAME
+// captured state and the SAME pre-generated view sequence.  The original loss,
+// LR rules and opacity/scaling optimization are retained; densify/clone/split/
+// prune and opacity reset are disabled by frozen_fixed_count_.
+// ---------------------------------------------------------------------------
+void GaussianMapperLine::runUndertrainContinuationDiagnostic()
+{
+    const char* root_env = std::getenv("PHOTO_SLAM_UNDERTRAIN_DIR");
+    if (!root_env || !root_env[0] || !gaussians_ || !scene_)
+        return;
+    if (scene_->keyframes().empty())
+        return;
+
+    const std::filesystem::path root(root_env);
+    std::filesystem::create_directories(root);
+
+    int max_steps = 1230;
+    if (const char* e = std::getenv("PHOTO_SLAM_UNDERTRAIN_STEPS"))
+        max_steps = std::max(1, std::atoi(e));
+    std::vector<long long> eval_steps = {0, 100, 400, 800, 1230};
+    if (const char* e = std::getenv("PHOTO_SLAM_UNDERTRAIN_EVAL_STEPS"))
+    {
+        eval_steps.clear();
+        std::stringstream ss(e);
+        std::string t;
+        while (std::getline(ss, t, ','))
+            if (!t.empty()) eval_steps.push_back(std::atoll(t.c_str()));
+        std::sort(eval_steps.begin(), eval_steps.end());
+        eval_steps.erase(std::unique(eval_steps.begin(), eval_steps.end()),
+                         eval_steps.end());
+        if (eval_steps.empty() || eval_steps.front() != 0)
+            eval_steps.insert(eval_steps.begin(), 0);
+    }
+
+    const RecoverySnapshot base = captureRecoverySnapshot();
+    const auto saved_eval = frozen_eval_kf_seq_;
+    const auto saved_kf_seq = frozen_kf_seq_;
+    const auto saved_train_views = frozen_train_views_flat_;
+    const bool saved_fixed = frozen_fixed_count_;
+    const bool saved_replay = frozen_kf_replay_;
+    const std::size_t saved_step = frozen_kf_step_;
+    const auto saved_result_dir = result_dir_;
+    const int saved_backend = RasterBackendGet();
+
+    // Fixed views: match the previous diagnostic's image list when supplied.
+    std::vector<std::string> wanted;
+    if (const char* e = std::getenv("PHOTO_SLAM_UNDERTRAIN_IMAGE_LIST"))
+    {
+        std::ifstream in(e);
+        std::string s;
+        while (std::getline(in, s))
+            if (!s.empty()) wanted.push_back(
+                std::filesystem::path(s).filename().string());
+    }
+    std::vector<std::size_t> eval_seq;
+    {
+        std::size_t idx = 0;
+        for (auto& kv : scene_->keyframes())
+        {
+            const std::string name =
+                std::filesystem::path(kv.second->img_filename_).filename().string();
+            const bool keep = wanted.empty()
+                                  ? (eval_seq.size() < 12)
+                                  : (std::find(wanted.begin(), wanted.end(), name)
+                                     != wanted.end());
+            if (keep) eval_seq.push_back(idx);
+            ++idx;
+        }
+    }
+    const std::size_t matched_eval_views = eval_seq.size();
+    bool eval_fallback = false;
+    if (eval_seq.size() < 12)
+    {
+        // The earlier fixed set can be partially culled by the live run.  A
+        // controlled A/C pair still needs >=12 common CURRENT training views;
+        // fall back to the first 12 map-order KFs and record the fallback.
+        eval_seq.clear();
+        std::size_t idx = 0;
+        for (auto& kv : scene_->keyframes())
+        {
+            if (eval_seq.size() >= 12) break;
+            eval_seq.push_back(idx++);
+        }
+        eval_fallback = true;
+    }
+    if (eval_seq.empty())
+    {
+        std::cerr << "[Undertrain] no evaluation views; skipping" << std::endl;
+        return;
+    }
+
+    // Generate the sequence with no evaluation exclusion: the requested views
+    // are TRAINING frames, not a held-out set.
+    frozen_eval_kf_seq_.clear();
+    frozen_kf_replay_ = false;
+    frozen_kf_step_ = 0;
+    preGenerateFrozenKfSequence(max_steps);
+    const std::size_t seq_len = frozen_kf_seq_.size();
+    frozen_eval_kf_seq_ = eval_seq;
+    restoreRecoverySnapshot(base);
+
+    std::cerr << "[Undertrain] terminal state captured: n="
+              << gaussians_->xyz_.size(0) << " kfs=" << scene_->keyframes().size()
+              << " steps=" << frozen_opt_steps_ << " seq=" << seq_len
+              << " eval_views=" << frozen_eval_kf_seq_.size() << std::endl;
+
+    {
+        std::ofstream st(root / "terminal_state.txt");
+        st << "head=undertrain-live-terminal-v1\n"
+           << "source=same_process_natural_end\n"
+           << "complete_optimizer_state=1\n"
+           << "iteration=" << base.iteration << "\n"
+           << "frozen_opt_steps=" << base.frozen_opt_steps << "\n"
+           << "gaussians=" << gaussians_->xyz_.size(0) << "\n";
+        long long nl = 0;
+        if (gaussians_->is_line_.defined() && gaussians_->is_line_.numel() > 0)
+            nl = gaussians_->is_line_.to(torch::kCPU).sum().item<int64_t>();
+        st << "line_gaussians=" << nl << "\n"
+           << "active_sh=" << base.active_sh << "\n"
+           << "default_sh=" << base.default_sh << "\n"
+           << "kfs=" << scene_->keyframes().size() << "\n"
+           << "rng_cpu_defined=" << (base.cpu_rng_state.defined() ? 1 : 0) << "\n"
+           << "rng_cuda_defined=" << (base.cuda_rng_state.defined() ? 1 : 0)
+           << "\n"
+           << "adam_groups=" << base.adam.size() << "\n";
+        for (std::size_t i = 0; i < base.adam.size(); ++i)
+        {
+            st << "adam_group=" << i << " step=" << base.adam[i].step
+               << " lr=" << (i < base.lrs.size() ? base.lrs[i] : -1.0f)
+               << " exp_avg=" << (base.adam[i].exp_avg.defined() ? 1 : 0)
+               << " exp_avg_sq="
+               << (base.adam[i].exp_avg_sq.defined() ? 1 : 0) << "\n";
+        }
+        st << "view_sequence_len=" << seq_len << "\n"
+           << "eval_views=" << eval_seq.size() << "\n"
+           << "eval_views_requested_matched=" << matched_eval_views << "\n"
+           << "eval_fallback_first_current_kfs=" << (eval_fallback ? 1 : 0)
+           << "\n"
+           << "topology_frozen=1\n"
+           << "camera_frozen=1\n"
+           << "line_loss_disabled=0\n";
+    }
+    {
+        std::ofstream vf(root / "eval_views.txt");
+        vf << "index,fid,image\n";
+        std::size_t idx = 0;
+        std::size_t k = 0;
+        for (auto& kv : scene_->keyframes())
+        {
+            if (k < eval_seq.size() && eval_seq[k] == idx)
+            {
+                vf << idx << ',' << kv.second->fid_ << ','
+                   << kv.second->img_filename_ << '\n';
+                ++k;
+            }
+            ++idx;
+        }
+    }
+
+    struct ArmSpec { const char* tag; int backend; };
+    const ArmSpec arms[] = {{"END_A", 0}, {"END_C", 2}};
+    std::ofstream summary(root / "summary.csv");
+    summary << "arm,backend,requested_steps,actual_steps,ok,gaussians,"
+               "line_gaussians,psnr_gs_0,psnr_gs_100,psnr_gs_400,"
+               "psnr_gs_800,psnr_gs_1230\n";
+    for (const auto& a : arms)
+    {
+        SetRasterBackend(a.backend);
+        std::srand(12345);
+        const auto out = root / a.tag;
+        auto r = runRecoveryArm(a.tag, base, base, {}, {}, 0, false, max_steps,
+                                eval_steps, out, false);
+        auto q = [&](long long s) {
+            auto it = r.eval_gs.find(s);
+            return it == r.eval_gs.end() ? -1.0 : it->second;
+        };
+        summary << a.tag << ',' << a.backend << ',' << max_steps << ','
+                << r.steps << ',' << (r.ok ? 1 : 0) << ','
+                << r.gaussians << ',' << r.line_gaussians << ','
+                << q(0) << ',' << q(100) << ',' << q(400) << ',' << q(800)
+                << ',' << q(1230) << '\n';
+        summary.flush();
+        std::cerr << "[Undertrain] arm=" << a.tag << " steps=" << r.steps
+                  << " ok=" << (r.ok ? 1 : 0) << " gs0=" << q(0)
+                  << " gs100=" << q(100) << " gs400=" << q(400)
+                  << " gs800=" << q(800) << " gs1230=" << q(1230)
+                  << std::endl;
+    }
+
+    SetRasterBackend(saved_backend);
+    restoreRecoverySnapshot(base);
