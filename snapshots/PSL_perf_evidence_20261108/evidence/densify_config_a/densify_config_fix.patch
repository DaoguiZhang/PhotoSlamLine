+// ---------------------------------------------------------------------------
+// variable-topology replay (diagnostic only).
+//
+// Triggered at one fixed iteration BEFORE a densification boundary. The live
+// mapper state is copied in memory; A0/A1 (backend A) and C (backend C) then
+// start from that SAME copy and run the NORMAL training entry with
+// densify/clone/split/prune enabled. The view sequence is generated once and
+// replayed; no SLAM MappingOperation is consumed during the arms.
+// ---------------------------------------------------------------------------
+void GaussianMapperLine::maybeRunTopologyReplay()
+{
+    const char* dir_env = std::getenv("PHOTO_SLAM_TOPO_REPLAY_DIR");
+    const char* at_env = std::getenv("PHOTO_SLAM_TOPO_REPLAY_AT");
+    if (!dir_env || !dir_env[0] || !at_env || !at_env[0] || topo_replay_done_ ||
+        !gaussians_ || !scene_)
+        return;
+    const long long at = std::atoll(at_env);
+    if (getIteration() != at) return;
+    topo_replay_done_ = true;
+
+    int steps = 400;
+    if (const char* e = std::getenv("PHOTO_SLAM_TOPO_REPLAY_STEPS"))
+        steps = std::max(1, std::atoi(e));
+    int views = 24;
+    if (const char* e = std::getenv("PHOTO_SLAM_TOPO_REPLAY_VIEWS"))
+        views = std::max(0, std::atoi(e));
+
+    const std::filesystem::path root(dir_env);
+    std::filesystem::create_directories(root);
+    const auto saved_result_dir = result_dir_;
+    const bool saved_fixed = frozen_fixed_count_;
+    const bool saved_replay = frozen_kf_replay_;
+    const std::size_t saved_kf_step = frozen_kf_step_;
+    const auto saved_eval_seq = frozen_eval_kf_seq_;
+    const auto saved_kf_seq = frozen_kf_seq_;
+    const auto saved_train_views = frozen_train_views_flat_;
+    const int saved_backend = RasterBackendGet();
+
+    RecoverySnapshot base = captureRecoverySnapshot();
+    const long long n0 = gaussians_->xyz_.size(0);
+    long long nl0 = 0;
+    if (gaussians_->is_line_.defined() && gaussians_->is_line_.numel() > 0)
+        nl0 = gaussians_->is_line_.to(torch::kCPU).to(torch::kBool)
+                  .sum().item<int64_t>();
+
+    // Fixed evaluation views (never trained on).
+    frozen_eval_kf_seq_.clear();
+    {
+        const std::size_t nkf = scene_->keyframes().size();
+        if (views > 0 && nkf > 0)
+        {
+            const std::size_t k = std::min<std::size_t>(
+                static_cast<std::size_t>(views), nkf);
+            for (std::size_t i = 0; i < k; ++i)
+                frozen_eval_kf_seq_.push_back((i * nkf) / k);
+        }
+    }
+
+    // Generate one sequence from the captured scheduler state, then restore the
+    // state so the first arm starts from the captured usage, not from the
+    // generator's reset. All arms replay the same `frozen_kf_seq_`.
+    preGenerateFrozenKfSequence(steps);
+    const std::size_t seq_len = frozen_kf_seq_.size();
+    restoreRecoverySnapshot(base);
+
+    {
+        std::ofstream st(root / "common_state.txt");
+        st << "head=topo-replay-v1\n"
+           << "at_iteration=" << at << "\n"
+           << "steps=" << steps << "\n"
+           << "gaussians=" << n0 << "\n"
+           << "line_gaussians=" << nl0 << "\n"
+           << "kfs=" << scene_->keyframes().size() << "\n"
+           << "iteration=" << iteration_ << "\n"
+           << "frozen_opt_steps=" << frozen_opt_steps_ << "\n"
+           << "active_sh=" << gaussians_->active_sh_degree_ << "\n"
+           << "default_sh=" << default_sh_ << "\n"
+           << "param_fp=" << gaussians_->paramFingerprint() << "\n"
+           << "adam_fp=" << gaussians_->adamFingerprint() << "\n"
+           << "sequence_len=" << seq_len << "\n"
+           << "eval_views=" << frozen_eval_kf_seq_.size() << "\n"
+           << "rng_seed=" << []() {
+                  const char* e = std::getenv("PHOTO_SLAM_TOPO_RNG_SEED");
+                  return e ? std::atoi(e) : 12345;
+              }()
+           << "\n"
+           << "rng_reset=std::rand_seed+restore_captured_torch_cpu_cuda\n"
+           << "saved_backend=" << saved_backend << "\n";
+    }
+    {
+        std::ofstream sf(root / "kf_sequence.txt");
+        sf << "# shared training sequence\n";
+        for (std::size_t i = 0; i < frozen_kf_seq_.size(); ++i)
+            sf << i << ' ' << frozen_kf_seq_[i] << '\n';
+    }
+    {
+        std::ofstream ef(root / "eval_views.txt");
+        ef << "# fixed evaluation keyframes (map order index)\n";
+        for (auto v : frozen_eval_kf_seq_) ef << v << '\n';
+    }
+
+    std::cerr << "[TopoReplay] at=" << at << " n=" << n0 << " line=" << nl0
+              << " steps=" << steps << " seq=" << seq_len << std::endl;
+
+    std::ofstream summar(root / "summary.csv");
+    summar << "arm,backend,steps,ok,gaussians,line_gaussians,psnr0,psnr100,"
+              "psnr_final,psnr_gs0,psnr_gs100,psnr_gs_final,param_fp0,"
+              "param_fp,clone_cum,split_cum,prune_cum\n";
+    const std::vector<long long> eval_steps = {0, 1, 10, 100, steps};
+    struct ArmSpec { const char* tag; int backend; };
+    const ArmSpec arms[] = {{"A0", 0}, {"A1", 0}, {"C", 2}};
+    for (const auto& a : arms)
+    {
+        SetRasterBackend(a.backend);
+        const auto out = root / a.tag;
+        auto r = runRecoveryArm(a.tag, base, base, {}, {}, 0, false, steps,
+                                eval_steps, out, true);
+        auto q = [&](long long s) {
+            auto it = r.eval_quality.find(s);
+            return it == r.eval_quality.end() ? -1.0 : it->second.first;
+        };
+        auto qg = [&](long long s) {
+            auto it = r.eval_gs.find(s);
+            return it == r.eval_gs.end() ? -1.0 : it->second;
+        };
+        summar << a.tag << ',' << a.backend << ',' << r.steps << ','
+               << (r.ok ? 1 : 0) << ',' << r.gaussians << ','
+               << r.line_gaussians << ',' << q(0) << ',' << q(100) << ','
+               << q(steps) << ',' << qg(0) << ',' << qg(100) << ','
+               << qg(steps) << ',' << r.param_fp0 << ',' << r.param_fp << ','
+               << gaussians_->auditCloneCount() << ','
+               << gaussians_->auditSplitCount() << ','
+               << gaussians_->auditPruneCount() << '\n';
+        summar.flush();
+        std::cerr << "[TopoReplay] arm=" << a.tag << " steps=" << r.steps
+                  << " n=" << r.gaussians << " line=" << r.line_gaussians
+                  << " psnr0=" << q(0) << " psnr_final=" << q(steps)
+                  << " gs0=" << qg(0) << " gs_final=" << qg(steps)
+                  << std::endl;
+    }
+
+    SetRasterBackend(saved_backend);
+    restoreRecoverySnapshot(base);
+    frozen_fixed_count_ = saved_fixed;
+    frozen_kf_replay_ = saved_replay;
+    frozen_kf_step_ = saved_kf_step;
+    frozen_eval_kf_seq_ = saved_eval_seq;
+    frozen_kf_seq_ = saved_kf_seq;
+    frozen_train_views_flat_ = saved_train_views;
+    result_dir_ = saved_result_dir;
+    // The capture is complete; do not run the remaining production sequence.
+    signalStop();
+}
+
+void GaussianMapperLine::writeAdamTopoState(const char* stage)
+{
+    const char* dir_env = std::getenv("PHOTO_SLAM_ADAM_TOPO_DIAG_DIR");
+    if (!dir_env || !dir_env[0] || !gaussians_ || !gaussians_->optimizer_)
+        return;
+    // Only topology boundaries; this is a short diagnostic, not a per-step
+    // profiler.  The host counter is used without any GPU synchronization.
+    if (getIteration() % 100 != 0) return;
+    std::filesystem::path dir(dir_env);
+    std::filesystem::create_directories(dir);
+    const auto path = dir / "adam_topo.csv";
+    const bool new_file = !std::filesystem::exists(path) ||
+                          std::filesystem::file_size(path) == 0;
+    std::ofstream out(path, std::ios::app);
+    if (new_file)
+        out << "iteration,optimizer_step_calls,stage,group,param_impl,"
+               "param_data,rows,row_total,grad_defined,adam_step,lr\n";
+    auto& groups = gaussians_->optimizer_->param_groups();
+    auto& state = gaussians_->optimizer_->state();
+    for (std::size_t i = 0; i < groups.size(); ++i)
+    {
+        if (groups[i].params().empty()) continue;
+        auto& p = groups[i].params()[0];
+        long long step = -1;
+        auto it = state.find(p.unsafeGetTensorImpl());
+        if (it != state.end())
+            step = static_cast<long long>(
+                static_cast<torch::optim::AdamParamState&>(*it->second).step());
+        auto g = p.grad();
+        out << getIteration() << ',' << frozen_opt_steps_ << ',' << stage
+            << ',' << i << ','
+            << reinterpret_cast<std::uintptr_t>(p.unsafeGetTensorImpl()) << ','
+            << reinterpret_cast<std::uintptr_t>(p.data_ptr()) << ','
+            << p.size(0) << ',' << gaussians_->xyz_.size(0) << ','
+            << (g.defined() ? 1 : 0) << ',' << step << ','
+            << static_cast<torch::optim::AdamOptions&>(groups[i].options()).lr()
+            << '\n';
+    }
+    out.flush();
+}
+
+void GaussianMapperLine::appendDensifyEvent(long long rows_before)
+{
+    const char* d = std::getenv("PHOTO_SLAM_ADAM_TOPO_DIAG_DIR");
+    if (!d || !d[0] || !gaussians_) return;
+    std::filesystem::path path = std::filesystem::path(d) / "densify_events.csv";
+    std::filesystem::create_directories(path.parent_path());
+    const bool fresh = !std::filesystem::exists(path) ||
+                       std::filesystem::file_size(path) == 0;
+    std::ofstream out(path, std::ios::app);
+    if (fresh)
+        out << "iteration,kind,rows_before,rows_after,delta,from_iter,"
+               "from_source,interval,trigger\n";
+    const long long rows_after = gaussians_->xyz_.size(0);
+    out << getIteration() << ",ordinary_densify," << rows_before << ','
+        << rows_after << ',' << (rows_after - rows_before) << ','
+        << opt_params_.densify_from_iter_ << ',' << densify_from_iter_source_
+        << ',' << densifyInterval()
+        << ",iteration>from_and_iteration%interval==0\n";
+    ++ordinary_densify_events_;
+}
