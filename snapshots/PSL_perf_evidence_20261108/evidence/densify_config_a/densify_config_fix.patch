+void GaussianMapperLine::writeStageCounters(const std::filesystem::path& dir)
+{
+    if (!stage_counters_enabled_ || !scene_ || !gaussians_) return;
+    std::filesystem::create_directories(dir);
+
+    {
+        std::ofstream out(dir / "stage_updates.csv");
+        out << "kind,key,updates\n";
+        for (const auto& kv : stage_level_counts_)
+            out << "pyramid_level," << kv.first << ',' << kv.second << '\n';
+        for (const auto& kv : stage_sh_counts_)
+            out << "active_sh," << kv.first << ',' << kv.second << '\n';
+        for (const auto& kv : stage_backend_counts_)
+            out << "backend," << (kv.first == 0 ? "A" :
+                                  (kv.first == 1 ? "B" : "C"))
+                << ',' << kv.second << '\n';
+        out << "training_pixels,,"
+            << stage_training_pixels_ << '\n';
+        out << "training_backward_rounds,," << train_backward_rounds_ << '\n';
+        out << "optimizer_step_calls,," << optimizer_step_calls_ << '\n';
+        out << "optimizer_step_calls_legacy_counter,," << frozen_opt_steps_
+            << '\n';
+        out << "adam_advance_total,," << adam_advance_total_ << '\n';
+        for (int gi = 0; gi < 8; ++gi)
+            out << "adam_advance_group," << gi << ',' << adam_advance_group_[gi]
+                << '\n';
+        out << "ordinary_densify_events,," << ordinary_densify_events_ << '\n';
+    }
+    {
+        long long a = 0, c = 0, switches = 0;
+        int last_b = -1, last_sh = -1;
+        GetRasterHStats(a, c, switches, last_b, last_sh);
+        std::ofstream out(dir / "raster_h_counts.csv");
+        out << "mode,actual_a_backward,actual_c_backward,switches,"
+               "last_backend,last_sh\n";
+        out << RasterBackendGet() << ',' << a << ',' << c << ',' << switches
+            << ',' << (last_b == 0 ? "A" : (last_b == 2 ? "C" : "none"))
+            << ',' << last_sh << '\n';
+    }
+    {
+        // Boundary audit only: host counters and Adam state fields, no GPU
+        // synchronization and no optimizer modification.
+        std::ofstream out(dir / "adam_boundary.csv");
+        out << "iteration,optimizer_step_calls,group,lr,step,param_rows,"
+               "exp_avg,exp_avg_sq\n";
+        if (gaussians_ && gaussians_->optimizer_)
+        {
+            auto& groups = gaussians_->optimizer_->param_groups();
+            auto& state = gaussians_->optimizer_->state();
+            for (std::size_t i = 0; i < groups.size(); ++i)
+            {
+                if (groups[i].params().empty()) continue;
+                auto& p = groups[i].params()[0];
+                long long step = -1;
+                bool ea = false, eas = false;
+                auto it = state.find(p.unsafeGetTensorImpl());
+                if (it != state.end())
+                {
+                    auto& st = static_cast<torch::optim::AdamParamState&>(
+                        *it->second);
+                    step = static_cast<long long>(st.step());
+                    ea = st.exp_avg().defined();
+                    eas = st.exp_avg_sq().defined();
+                }
+                out << getIteration() << ',' << frozen_opt_steps_ << ',' << i
+                    << ',' << static_cast<torch::optim::AdamOptions&>(
+                                  groups[i].options()).lr()
+                    << ',' << step << ',' << p.size(0) << ',' << (ea ? 1 : 0)
+                    << ',' << (eas ? 1 : 0) << '\n';
+            }
+        }
+    }
+    {
+        std::ofstream out(dir / "kf_usage.csv");
+        out << "fid,used_times,remaining_times_of_use\n";
+        for (const auto& kv : scene_->keyframes())
+        {
+            auto it = kfs_used_times_.find(kv.first);
+            out << kv.first << ',' << (it == kfs_used_times_.end() ? 0 : it->second)
+                << ',' << kv.second->remaining_times_of_use_ << '\n';
+        }
+    }
+    {
+        const bool shutdown = pSLAM_ && pSLAM_->isShutDown();
+        const bool queue = pSLAM_ && pSLAM_->getAtlas()->hasMappingOperation();
+        std::string reason = "running";
+        if (isStopped()) reason = "mapper_stopped";
+        else if (shutdown) reason = "slam_shutdown";
+        else if (getIteration() >= opt_params_.iterations_) reason = "iteration_cap";
+        std::ofstream out(dir / "progress.csv");
+        out << "input_frame,total_input_frames,mapper_iteration,"
+               "optimizer_step_calls,training_backward_rounds,"
+               "adam_advance_total,kfs,gaussians,queue_pending,slam_shutdown,"
+               "mapper_stopped,stop_reason,local_ba_consumption\n";
+        out << photo_slam_diag::getInputFrame() << ','
+            << photo_slam_diag::getTotalFrames() << ',' << getIteration() << ','
+            << optimizer_step_calls_ << ',' << train_backward_rounds_ << ','
+            << adam_advance_total_ << ',' << scene_->keyframes().size() << ','
+            << gaussians_->xyz_.size(0) << ',' << (queue ? 1 : 0) << ','
+            << (shutdown ? 1 : 0) << ',' << (isStopped() ? 1 : 0) << ','
+            << reason << ",localba_consumption.csv\n";
+    }
+}
