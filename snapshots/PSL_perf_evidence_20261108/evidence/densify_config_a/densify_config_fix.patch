 namespace {
+// Read one integer setting.  A missing node is NOT converted to 0 silently;
+// callers must decide whether a missing value is an error or an explicit
+// default.  The densify_from_iter canonical/legacy resolver below is the only
+// setting whose semantics are changed in this round.
+bool readIntNode(const cv::FileNode& node, int& value)
+{
+    if (node.isNone())
+        return false;
+    if (node.isInt())
+    {
+        value = static_cast<int>(node);
+        return true;
+    }
+    if (node.isReal())
+    {
+        value = static_cast<int>(std::lround(static_cast<double>(node)));
+        return true;
+    }
+    return false;
+}
+
+const char* sourceOf(const cv::FileNode& node, const char* key)
+{
+    static thread_local std::string buf;
+    buf = node.isNone() ? std::string("missing(") + key + ")"
+                        : std::string("config:") + key;
+    return buf.c_str();
