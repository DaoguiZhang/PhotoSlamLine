+void GaussianMapperLine::maybeCheckpointOnline()
+{
+    const char* root_env = std::getenv("PHOTO_SLAM_ONLINE_CHECKPOINT_DIR");
+    if (!root_env || !root_env[0] || !gaussians_ || !scene_) return;
+    if (online_ckpt_cursor_ >= 8) return;
+
+    static const std::vector<long long> thresholds = []() {
+        std::vector<long long> v;
+        const char* e = std::getenv("PHOTO_SLAM_ONLINE_CHECKPOINT_FRAMES");
+        std::string s = e ? e : "500,1000,1500,end";
+        std::stringstream ss(s);
+        std::string t;
+        while (std::getline(ss, t, ','))
+        {
+            if (t == "end" || t == "END")
+                v.push_back(-1);
+            else if (!t.empty())
+                v.push_back(std::atoll(t.c_str()));
+        }
+        return v;
+    }();
+    if (thresholds.empty()) return;
+
+    const long long in_frame = photo_slam_diag::getInputFrame();
+    const long long total = photo_slam_diag::getTotalFrames();
+    while (online_ckpt_cursor_ < thresholds.size())
+    {
+        const long long th = thresholds[online_ckpt_cursor_];
+        const long long target = th < 0 ? total : th;
+        if (target < 0 || in_frame < target) return;
+        const std::string label = th < 0 ? "end" : std::to_string(th);
+        const std::filesystem::path root(root_env);
+        const auto dir = root / ("frame_" + label);
+        std::filesystem::create_directories(dir);
+        ++online_ckpt_cursor_;
+
+        const auto t0 = std::chrono::steady_clock::now();
+        const auto snap_path = dir / "snapshot.pt";
+        gaussians_->saveFullSnapshot(snap_path.string());
+        const auto t1 = std::chrono::steady_clock::now();
+
+        {
+            std::ofstream cam(dir / "cameras.csv");
+            cam << "fid,img_name,qw,qx,qy,qz,tx,ty,tz,fx,fy,cx,cy,width,height\n";
+            for (auto& kv : scene_->keyframes())
+            {
+                auto& p = kv.second;
+                if (!p) continue;
+                const Sophus::SE3d T = p->getPose();
+                const Eigen::Quaterniond q = T.unit_quaternion();
+                const Eigen::Vector3d t = T.translation();
+                cam << p->fid_ << ',' << p->img_filename_ << ',' << q.w() << ','
+                    << q.x() << ',' << q.y() << ',' << q.z() << ',' << t.x()
+                    << ',' << t.y() << ',' << t.z();
+                if (p->intr_.size() >= 4)
+                    cam << ',' << p->intr_[0] << ',' << p->intr_[1] << ','
+                        << p->intr_[2] << ',' << p->intr_[3];
+                else
+                    cam << ",0,0,0,0";
+                cam << ',' << p->image_width_ << ',' << p->image_height_ << '\n';
+            }
+        }
+        {
+            std::vector<torch::Tensor> masks;
+            std::ofstream ids(dir / "mask_cameras.txt");
+            for (auto& kv : undistort_mask_)
+            {
+                ids << kv.first << '\n';
+                masks.push_back(kv.second.detach().to(torch::kCPU));
+            }
+            torch::save(masks, (dir / "masks.pt").string());
+        }
+        {
+            long long nl = 0;
+            if (gaussians_->is_line_.defined() && gaussians_->is_line_.numel())
+                nl = gaussians_->is_line_.to(torch::kCPU).sum().item<int64_t>();
+            std::ofstream meta(dir / "meta.txt");
+            meta << "checkpoint=" << label << "\n"
+                 << "input_frame=" << in_frame << "\n"
+                 << "total_input_frames=" << total << "\n"
+                 << "mapper_kfs=" << scene_->keyframes().size() << "\n"
+                 << "iteration=" << getIteration() << "\n"
+                 << "optimizer_steps=" << frozen_opt_steps_ << "\n"
+                 << "gaussians=" << gaussians_->xyz_.size(0) << "\n"
+                 << "line_gaussians=" << nl << "\n"
+                 << "active_sh=" << gaussians_->active_sh_degree_ << "\n"
+                 << "default_sh=" << default_sh_ << "\n"
+                 << "record_rendered_image=" << (record_rendered_image_ ? 1 : 0)
+                 << "\nrecord_ground_truth_image="
+                 << (record_ground_truth_image_ ? 1 : 0) << "\n"
+                 << "render_width=" << (scene_->keyframes().empty()
+                                            ? 0 : scene_->keyframes().begin()->second->image_width_)
+                 << "\n";
+        }
+
+        writeStageCounters(dir);
+
+        // Read-only render at the checkpoint. This is a diagnostic snapshot;
+        // its timing is not a production performance result.
+        const auto t2 = std::chrono::steady_clock::now();
+        renderAndRecordAllKeyframesReadOnly("_ckpt" + label);
+        const auto t3 = std::chrono::steady_clock::now();
+        const double save_s = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                  t1 - t0).count() / 1000.0;
+        const double render_s = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                    t3 - t2).count() / 1000.0;
+        {
+            std::ofstream tm(dir / "checkpoint_timing.txt");
+            tm << "save_seconds=" << save_s << "\n"
+               << "render_seconds=" << render_s << "\n"
+               << "total_seconds=" << (save_s + render_s) << "\n";
+        }
+        std::cerr << "[OnlineCheckpoint] frame=" << target
+                  << " input=" << in_frame << " kfs="
+                  << scene_->keyframes().size() << " iter=" << getIteration()
+                  << " steps=" << frozen_opt_steps_ << " save_s=" << save_s
+                  << " render_s=" << render_s << std::endl;
+    }
+}
