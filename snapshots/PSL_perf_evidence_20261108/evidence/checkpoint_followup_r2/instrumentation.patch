+// ---------------------------------------------------------------------------
+// Controlled under-training diagnostic at the live natural end.
+//
+// The existing end snapshot does not contain Adam moments or learning rates,
+// so it cannot be resumed offline without silently rebuilding optimizer state.
+// This hook is therefore called while the process still owns the complete
+// in-memory state.  It runs two fixed-topology arms (A and C) from the SAME
+// captured state and the SAME pre-generated view sequence.  The original loss,
+// LR rules and opacity/scaling optimization are retained; densify/clone/split/
+// prune and opacity reset are disabled by frozen_fixed_count_.
+// ---------------------------------------------------------------------------
+void GaussianMapperLine::runUndertrainContinuationDiagnostic()
+{
+    const char* root_env = std::getenv("PHOTO_SLAM_UNDERTRAIN_DIR");
+    if (!root_env || !root_env[0] || !gaussians_ || !scene_)
+        return;
+    if (scene_->keyframes().empty())
+        return;
+
+    const std::filesystem::path root(root_env);
+    std::filesystem::create_directories(root);
+
+    int max_steps = 1230;
+    if (const char* e = std::getenv("PHOTO_SLAM_UNDERTRAIN_STEPS"))
+        max_steps = std::max(1, std::atoi(e));
+    std::vector<long long> eval_steps = {0, 100, 400, 800, 1230};
+    if (const char* e = std::getenv("PHOTO_SLAM_UNDERTRAIN_EVAL_STEPS"))
+    {
+        eval_steps.clear();
+        std::stringstream ss(e);
+        std::string t;
+        while (std::getline(ss, t, ','))
+            if (!t.empty()) eval_steps.push_back(std::atoll(t.c_str()));
+        std::sort(eval_steps.begin(), eval_steps.end());
+        eval_steps.erase(std::unique(eval_steps.begin(), eval_steps.end()),
+                         eval_steps.end());
+        if (eval_steps.empty() || eval_steps.front() != 0)
+            eval_steps.insert(eval_steps.begin(), 0);
+    }
+
+    const RecoverySnapshot base = captureRecoverySnapshot();
+    const auto saved_eval = frozen_eval_kf_seq_;
+    const auto saved_kf_seq = frozen_kf_seq_;
+    const auto saved_train_views = frozen_train_views_flat_;
+    const bool saved_fixed = frozen_fixed_count_;
+    const bool saved_replay = frozen_kf_replay_;
+    const std::size_t saved_step = frozen_kf_step_;
+    const auto saved_result_dir = result_dir_;
+    const int saved_backend = RasterBackendGet();
+
