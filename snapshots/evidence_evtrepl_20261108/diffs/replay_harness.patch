+// ===========================================================================
+// Common input + geometry event stream: export (live run) and replay
+// ===========================================================================
+//
+// Export (PHOTO_SLAM_EXPORT_DIR) writes, for one live SLAM+mapping run:
+//   snapshot.txt         the initial, un-optimised model (initial keyframe set
+//                        with the poses they were born with + the initial
+//                        sparse point cloud incl. line samples)
+//   kf_index.txt         every keyframe that ever entered the mapper
+//   kf_img/, kf_aux/     the exact (already undistorted) images each keyframe
+//                        trains on, lossless PNG
+//   events/eNNNNN_type.txt  every MappingOperation the live mapper consumed,
+//                        in order, with the iteration at which it consumed it
+//   events/index.csv     compact time line of the same
+//
+// Replay (PHOTO_SLAM_REPLAY_DIR) rebuilds keyframes/model/Adam/voxel grid from
+// those files for each condition and pushes every event through the real
+// Atlas queue -> combineMappingOperations_withLine() consumer. Nothing is
+// transformed by the harness itself: the only code that moves Gaussians is the
+// production consumer.
+// ---------------------------------------------------------------------------
+
+namespace {
+std::string replayEnvStr(const char *key)
+{
+    const char *e = std::getenv(key);
+    return (e == nullptr) ? std::string() : std::string(e);
+}
+}  // namespace
+
+bool GaussianMapperLine::replayExportEnabled() const
+{
+    // A replay must never write back into the stream it is reading: the
+    // consumer it drives is the same one that records events, so without this
+    // guard every replayed event would be appended to the export again.
+    if (replay_running_)
+        return false;
+    const char *e = std::getenv("PHOTO_SLAM_EXPORT_DIR");
+    return e != nullptr && e[0] != '\0';
+}
+
+bool GaussianMapperLine::replayEnabled() const
+{
+    const char *e = std::getenv("PHOTO_SLAM_REPLAY_DIR");
+    return e != nullptr && e[0] != '\0';
+}
+
+void GaussianMapperLine::exportKeyframeBirth(
+    const std::shared_ptr<GaussianKeyframeLine> &pkf,
+    const cv::Mat &img_undist,
+    const cv::Mat &img_aux_undist)
+{
+    if (!replayExportEnabled() || !pkf)
+        return;
+    if (replay_export_dir_.empty())
+        replay_export_dir_ = replayExportDir();
+
+    psl_replay::KfRecord k;
+    k.fid = pkf->fid_;
+    k.camera_id = pkf->camera_id_;
+    const Sophus::SE3f T = pkf->getPosef();
+    const Eigen::Quaternionf q = T.unit_quaternion();
+    const Eigen::Vector3f t = T.translation();
+    k.q[0] = q.w(); k.q[1] = q.x(); k.q[2] = q.y(); k.q[3] = q.z();
+    k.t[0] = t.x(); k.t[1] = t.y(); k.t[2] = t.z();
+    k.width = img_undist.empty() ? 0 : img_undist.cols;
+    k.height = img_undist.empty() ? 0 : img_undist.rows;
+    k.has_aux = img_aux_undist.empty() ? 0 : 1;
+    k.rgb_code = psl_replay::imgCode(img_undist);
+    k.aux_code = psl_replay::imgCode(img_aux_undist);
+    k.creation_iter = static_cast<long long>(getIteration());
+    k.name = pkf->img_filename_;
+
+    if (!psl_replay::writeKfImages(replay_export_dir_, k.fid, img_undist,
+                                   k.rgb_code, img_aux_undist, k.aux_code))
+        std::cerr << "[ReplayExport] WARNING: image write failed for kf "
+                  << k.fid << std::endl;
+    psl_replay::appendKfRecord(replay_export_dir_, k);
+}
+
+void GaussianMapperLine::exportSnapshotOnce()
+{
+    if (!replayExportEnabled() || replay_snapshot_written_)
+        return;
+    if (replay_export_dir_.empty())
+        replay_export_dir_ = replayExportDir();
+
+    psl_replay::Snapshot s;
+    s.extent = scene_->cameras_extent_;
+    s.natural_iter = static_cast<long long>(getIteration());
+    s.coord_epoch = replay_coord_epoch_;
+    {
+        auto pMap = pSLAM_ ? pSLAM_->getAtlas()->GetCurrentMap() : nullptr;
+        s.map_id = pMap ? std::to_string(pMap->GetId()) : std::string("0");
+    }
+    for (auto &kv : scene_->keyframes()) {
+        const auto &pkf = kv.second;
+        psl_replay::KfRecord k;
+        k.fid = pkf->fid_;
+        k.camera_id = pkf->camera_id_;
+        const Sophus::SE3f T = pkf->getPosef();
+        const Eigen::Quaternionf q = T.unit_quaternion();
+        const Eigen::Vector3f t = T.translation();
+        k.q[0] = q.w(); k.q[1] = q.x(); k.q[2] = q.y(); k.q[3] = q.z();
+        k.t[0] = t.x(); k.t[1] = t.y(); k.t[2] = t.z();
+        k.width = pkf->image_width_;
+        k.height = pkf->image_height_;
+        k.has_aux = pkf->img_auxiliary_undist_.empty() ? 0 : 1;
+        k.rgb_code = psl_replay::imgCode(pkf->img_undist_);
+        k.aux_code = psl_replay::imgCode(pkf->img_auxiliary_undist_);
+        k.creation_iter = 0;  // born in the initial mapping round
+        k.name = pkf->img_filename_;
+        s.kfs.push_back(k);
+    }
+    s.pcd = scene_->cached_point_cloud_;
+
+    if (psl_replay::writeSnapshot(replay_export_dir_, s))
+        std::cerr << "[ReplayExport] snapshot written: kfs=" << s.kfs.size()
+                  << " pcd=" << s.pcd.size() << " extent=" << s.extent
+                  << " natural_iter=" << s.natural_iter
+                  << " epoch=" << s.coord_epoch
+                  << " hash=" << psl_replay::hashHex(psl_replay::snapshotText(s))
+                  << std::endl;
+    else
+        std::cerr << "[ReplayExport] ERROR: snapshot write failed" << std::endl;
+    replay_snapshot_written_ = true;
+}
+
+// Total length of the live run on the mapper iteration axis. The event stream
+// is scheduled against this so a recorded event keeps its relative position in
+// the optimisation budget instead of all of them collapsing onto one step.
+void GaussianMapperLine::exportRunMetaOnce()
+{
+    if (!replayExportEnabled())
+        return;
+    const auto dir = replayExportDir();
+    std::filesystem::create_directories(dir);
+    std::ofstream out(dir / "run_meta.txt");
+    out << "total_iteration=" << getIteration() << "\n";
+    out << "n_events=" << replay_export_seq_ << "\n";
+    out << "keyframes=" << scene_->keyframes().size() << "\n";
+    out << "gaussians="
+        << (gaussians_ && gaussians_->xyz_.defined() ? gaussians_->xyz_.size(0) : 0)
+        << "\n";
+    std::cerr << "[ReplayExport] run_meta: total_iteration=" << getIteration()
+              << " n_events=" << replay_export_seq_ << std::endl;
+}
+
+void GaussianMapperLine::exportMappingOperation(ORB_SLAM3::MappingOperation &opr,
+                                                long long iter)
+{
+    if (!replayExportEnabled())
+        return;
+    if (replay_export_dir_.empty())
+        replay_export_dir_ = replayExportDir();
+
+    psl_replay::Event e;
+    e.seq = ++replay_export_seq_;
+    e.type = static_cast<int>(opr.meOperationType);
+    e.scale = opr.mfScale;
+    e.iteration = iter;
+    {
+        const Eigen::Quaternionf q = opr.mT.unit_quaternion();
+        const Eigen::Vector3f t = opr.mT.translation();
+        e.tq[0] = q.w(); e.tq[1] = q.x(); e.tq[2] = q.y(); e.tq[3] = q.z();
+        e.tt[0] = t.x(); e.tt[1] = t.y(); e.tt[2] = t.z();
+    }
+    for (auto &kf : opr.associatedKeyFrames()) {
+        psl_replay::EvKf k;
+        k.fid = std::get<0>(kf);
+        k.camera_id = std::get<1>(kf);
+        const Sophus::SE3f &pose = std::get<2>(kf);
+        const Eigen::Quaternionf q = pose.unit_quaternion();
+        const Eigen::Vector3f t = pose.translation();
+        k.q[0] = q.w(); k.q[1] = q.x(); k.q[2] = q.y(); k.q[3] = q.z();
+        k.t[0] = t.x(); k.t[1] = t.y(); k.t[2] = t.z();
+        e.kfs.push_back(k);
+    }
+    {
+        auto &mp = opr.associatedMapPoints();
+        const auto &pos = std::get<0>(mp);
+        const auto &col = std::get<1>(mp);
+        const std::size_t n = std::min(pos.size(), col.size()) / 3;
+        e.pts.reserve(n);
+        for (std::size_t i = 0; i < n; ++i) {
+            psl_replay::EvPoint p;
+            for (int d = 0; d < 3; ++d) {
+                p.p[d] = pos[i * 3 + d];
+                p.c[d] = col[i * 3 + d];
+            }
+            e.pts.push_back(p);
+        }
+    }
+    {
+        auto &ls = opr.associatedLineSampledPoints();
+        const auto &pos = std::get<0>(ls);
+        const auto &col = std::get<1>(ls);
+        const auto &dir = std::get<2>(ls);
+        const std::size_t n = std::min({pos.size(), col.size(), dir.size()}) / 3;
+        e.lpts.reserve(n);
+        for (std::size_t i = 0; i < n; ++i) {
+            psl_replay::EvLineSample l;
+            for (int d = 0; d < 3; ++d) {
+                l.p[d] = pos[i * 3 + d];
+                l.c[d] = col[i * 3 + d];
+                l.d[d] = dir[i * 3 + d];
+            }
+            e.lpts.push_back(l);
+        }
+    }
+    if (e.type == 3)
+        ++replay_coord_epoch_;
+
+    if (!psl_replay::writeEvent(replay_export_dir_, e))
+        std::cerr << "[ReplayExport] ERROR: event write failed seq=" << e.seq
+                  << std::endl;
+
+    std::ofstream idx(replay_export_dir_ / "events" / "index.csv",
+                      std::ios::app);
+    if (idx.is_open()) {
+        if (idx.tellp() == 0)
+            idx << "seq,type,type_name,iteration,scale,n_kfs,n_points,n_line_samples\n";
+        idx << e.seq << ',' << e.type << ',' << psl_replay::oprTypeName(e.type)
+            << ',' << e.iteration << ',' << e.scale << ',' << e.kfs.size()
+            << ',' << e.pts.size() << ',' << e.lpts.size() << '\n';
+    }
+}
+
+void GaussianMapperLine::replayEvaluate(const std::vector<std::size_t> &kf_idx,
+                                        double &psnr,
+                                        double &ssim,
+                                        std::ostringstream *rows)
+{
+    psnr = 0.0;
+    ssim = 0.0;
+    if (kf_idx.empty() || !gaussians_ || gaussians_->xyz_.size(0) == 0)
+        return;
+    torch::NoGradGuard no_grad;
+    double sp = 0.0, ss = 0.0;
+    std::size_t n = 0;
+    for (std::size_t target : kf_idx) {
+        auto it = scene_->keyframes().begin();
+        std::advance(it, static_cast<long>(target));
+        if (it == scene_->keyframes().end())
+            continue;
+        auto pkf = it->second;
+        auto render_pkg = GaussianRendererWithLine::renderWithLine(
+            pkf, pkf->image_height_, pkf->image_width_, gaussians_,
+            pipe_params_, background_, override_color_);
+        torch::Tensor rendered = std::get<0>(render_pkg);
+        torch::Tensor masked = rendered * undistort_mask_[pkf->camera_id_];
+        torch::cuda::synchronize();
+        const float p = loss_utils::psnr(masked, pkf->original_image_).item().toFloat();
+        const float s = loss_utils::ssim(masked, pkf->original_image_, device_type_)
+                            .item()
+                            .toFloat();
+        sp += p;
+        ss += s;
+        ++n;
+        if (rows != nullptr)
+            *rows << pkf->fid_ << ',' << p << ',' << s << '\n';
+    }
+    if (n > 0) {
+        psnr = sp / static_cast<double>(n);
+        ssim = ss / static_cast<double>(n);
+    }
+}
+
+void GaussianMapperLine::injectReplayEvent(
+    const psl_replay::Event &ev,
+    ReplayEventStat &st,
+    const std::vector<std::size_t> &eval_idx,
+    const std::vector<std::size_t> &train_idx,
+    const std::filesystem::path &eval_out)
+{
+    using ORB_SLAM3::MappingOperation;
+
+    st.seq = ev.seq;
+    st.type = ev.type_name;
+    st.replay_step = ev.replay_step;
+    st.v = ORB_SLAM3::DedupVoxelLive() ? 1 : 0;
+    st.n = ORB_SLAM3::DedupNotifyEnabled() ? 1 : 0;
+    st.ev_kfs = ev.kfs.size();
+    st.ev_pts = ev.pts.size();
+    st.ev_lpts = ev.lpts.size();
+    st.n_gauss_before = gaussians_->xyz_.size(0);
+    st.n_line_before = gaussians_->is_line_.defined()
+                           ? gaussians_->is_line_.sum().item<int64_t>()
+                           : 0;
+    const auto vox0 = scene_->voxel_stats();
+
+    const bool key_event = psl_replay::isGeometryEvent(ev.type);
+    if (key_event && replay_eval_every_key_event_) {
+        double p = -1.0, s = -1.0;
+        replayEvaluate(eval_idx, p, s, nullptr);
+        st.have_eval = 1;
+        st.psnr_eval_before = p;
+        st.ssim_eval_before = s;
+        // train-view number, kept in a member: separated from the held-out one
+        // so a "reconstruction went up because the model memorised" case stays
+        // visible instead of being averaged away.
+        double p2 = -1.0, s2 = -1.0;
+        replayEvaluate(train_idx, p2, s2, nullptr);
+        st.psnr_train_before = p2;
+        st.ssim_train_before = s2;
+    }
+
+    Sophus::SE3f T;
+    T.setQuaternion(Eigen::Quaternionf(ev.tq[0], ev.tq[1], ev.tq[2], ev.tq[3]).normalized());
+    T.translation() = Eigen::Vector3f(ev.tt[0], ev.tt[1], ev.tt[2]);
+
+    MappingOperation opr(static_cast<MappingOperation::OprType>(ev.type), ev.scale,
+                         T, ev.kfs.size(), ev.pts.size());
+    // Keyframes are rebuilt with their (undistorted) image loaded from the
+    // exported PNG, so a merge that creates a keyframe the scene does not know
+    // yet still goes through the production creation path.
+    for (const auto &k : ev.kfs) {
+        Eigen::Quaternionf q(k.q[0], k.q[1], k.q[2], k.q[3]);
+        Sophus::SE3f pose;
+        pose.setQuaternion(q.normalized());
+        pose.translation() = Eigen::Vector3f(k.t[0], k.t[1], k.t[2]);
+        cv::Mat img, aux;
+        const auto it = replay_image_cache_.find(k.fid);
+        if (it != replay_image_cache_.end()) {
+            img = it->second.first;
+            aux = it->second.second;
+        }
+        opr.replayAddKeyFrame(k.fid, k.camera_id, pose, img, false, aux, {}, {},
+                              std::string(), {});
+    }
+    for (const auto &p : ev.pts)
+        opr.replayAddMapPoint(p.p[0], p.p[1], p.p[2], p.c[0], p.c[1], p.c[2]);
+    for (const auto &l : ev.lpts)
+        opr.replayAddLineSample(l.p[0], l.p[1], l.p[2], l.c[0], l.c[1], l.c[2],
+                                l.d[0], l.d[1], l.d[2]);
+
+    last_consumer_ = {};
+    const auto t0 = std::chrono::steady_clock::now();
+    pSLAM_->getAtlas()->pushMappingOperation(opr);
+    combineMappingOperations_withLine();
+    torch::cuda::synchronize();
+    st.event_ms = std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now() - t0)
+                      .count() / 1000.0;
+
+    const auto vox1 = scene_->voxel_stats();
+    st.voxel_rebuilds = vox1.rebuilds - vox0.rebuilds;
+    st.voxel_invalidations = vox1.invalidations - vox0.invalidations;
+    st.voxel_points = vox1.rebuild_points - vox0.rebuild_points;
+    st.voxel_ms = vox1.rebuild_ms - vox0.rebuild_ms;
+
+    st.n_gauss_after = gaussians_->xyz_.size(0);
+    st.n_line_after = gaussians_->is_line_.defined()
+                          ? gaussians_->is_line_.sum().item<int64_t>()
+                          : 0;
+    st.gauss_created = st.n_gauss_after - st.n_gauss_before;
+    st.kfs_created = last_consumer_.created;
+    st.kfs_corrected = last_consumer_.corrected;
+    st.kfs_skipped = last_consumer_.skipped;
+    st.points_transformed = last_consumer_.points_transformed;
+    st.line_transformed = last_consumer_.line_transformed;
+    st.non_finite = last_consumer_.non_finite;
+    st.finite_ok = (gaussians_->xyz_.size(0) == 0 ||
+                    torch::isfinite(gaussians_->xyz_).all().item<bool>())
+                       ? 1
+                       : 0;
+
+    if (key_event && replay_eval_every_key_event_) {
+        double p = -1.0, s = -1.0;
+        replayEvaluate(eval_idx, p, s, nullptr);
+        st.psnr_eval_after = p;
+        st.ssim_eval_after = s;
+    }
+
+    std::cerr << "[ReplayEvent] seq=" << st.seq << " type=" << st.type
+              << " step=" << st.replay_step << " v=" << st.v << " n=" << st.n
+              << " gauss=" << st.n_gauss_before << "->" << st.n_gauss_after
+              << " line=" << st.n_line_before << "->" << st.n_line_after
+              << " corrected=" << st.kfs_corrected
+              << " ptsTf=" << st.points_transformed
+              << " lineTf=" << st.line_transformed
+              << " voxReb=" << st.voxel_rebuilds
+              << " finite=" << st.finite_ok
+              << " ms=" << st.event_ms << std::endl;
+    (void)eval_out;
+}
+
+void GaussianMapperLine::writeReplayEventLog(const std::filesystem::path &dir)
 {
+    std::filesystem::create_directories(dir);
+    std::ofstream out(dir / "event_log.csv");
+    out << "seq,type,replay_step,v,n,ev_kfs,ev_points,ev_line_samples,"
+           "gauss_before,gauss_after,gauss_delta,line_before,line_after,"
+           "kfs_created,kfs_corrected,kfs_skipped,points_transformed,"
+           "line_transformed,non_finite,voxel_rebuilds,voxel_invalidations,"
+           "voxel_points,voxel_ms,event_ms,finite_ok,have_eval,"
+           "psnr_eval_before,psnr_eval_after,ssim_eval_before,ssim_eval_after\n";
+    for (const auto &s : replay_event_stats_)
+        out << s.seq << ',' << s.type << ',' << s.replay_step << ',' << s.v << ','
+            << s.n << ',' << s.ev_kfs << ',' << s.ev_pts << ',' << s.ev_lpts
+            << ',' << s.n_gauss_before << ',' << s.n_gauss_after << ','
+            << (s.n_gauss_after - s.n_gauss_before) << ',' << s.n_line_before
+            << ',' << s.n_line_after << ',' << s.kfs_created << ','
+            << s.kfs_corrected << ',' << s.kfs_skipped << ','
+            << s.points_transformed << ',' << s.line_transformed << ','
+            << s.non_finite << ',' << s.voxel_rebuilds << ','
+            << s.voxel_invalidations << ',' << s.voxel_points << ','
+            << s.voxel_ms << ',' << s.event_ms << ',' << s.finite_ok << ','
+            << s.have_eval << ',' << s.psnr_eval_before << ','
+            << s.psnr_eval_after << ',' << s.ssim_eval_before << ','
+            << s.ssim_eval_after << '\n';
+}
+
+// ---------------------------------------------------------------------------
+// The replay driver.
+//
+// For every (scene, seed) export there are five conditions. They all start from
+// the SAME snapshot file. Per condition the harness rebuilds, from those files:
+//   * the keyframe objects (image tensors, pyramid tensors, poses),
+//   * the Gaussian model (and therefore a fresh Adam state),
+//   * the voxel grid,
+//   * the iteration counter, the SH degree schedule, the keyframe usage
+//     bookkeeping and the libc rand() state.
+// The only things that differ are the V/N switch values. The event stream is
+// replayed by pushing each exported MappingOperation into the real Atlas queue
+// and letting combineMappingOperations_withLine() consume it, so the code that
+// moves Gaussians is the production consumer, not the harness.
+// ---------------------------------------------------------------------------
+void GaussianMapperLine::runReplay()
+{
+    using namespace psl_replay;
+
+    replay_dir_ = replayEnvStr("PHOTO_SLAM_REPLAY_DIR");
+    if (replay_dir_.empty())
+        return;
+    replay_running_ = true;
+    if (const char *s = std::getenv("PHOTO_SLAM_REPLAY_STEPS")) {
+        const int v = std::atoi(s);
+        if (v > 0)
+            replay_steps_ = v;
+    }
+
+    // ---------------- read and verify the common input -------------------
+    Snapshot snap;
+    if (!readSnapshot(replay_dir_, snap)) {
+        std::cerr << "[Replay] FATAL: cannot read/verify "
+                  << (replay_dir_ / "snapshot.txt") << std::endl;
+        throw std::runtime_error("replay: bad snapshot");
+    }
+    std::vector<KfRecord> kfs;
+    if (!readKfIndex(replay_dir_, kfs) || kfs.empty()) {
+        std::cerr << "[Replay] FATAL: cannot read kf_index.txt" << std::endl;
+        throw std::runtime_error("replay: bad keyframe index");
+    }
+    std::sort(kfs.begin(), kfs.end(),
+              [](const KfRecord &a, const KfRecord &b) { return a.fid < b.fid; });
+    std::vector<Event> events;
+    if (!readEventIndex(replay_dir_, events)) {
+        std::cerr << "[Replay] FATAL: event stream unreadable or hash mismatch"
+                  << std::endl;
+        throw std::runtime_error("replay: bad event stream");
+    }
+
+    // Every keyframe the stream refers to must have an image on disk.
+    {
+        std::map<unsigned long, bool> known;
+        for (const auto &k : kfs)
+            known[k.fid] = true;
+        std::size_t missing = 0;
+        for (const auto &e : events)
+            for (const auto &k : e.kfs)
+                if (!known.count(k.fid))
+                    ++missing;
+        if (missing > 0) {
+            std::cerr << "[Replay] FATAL: " << missing
+                      << " event keyframe references have no image record"
+                      << std::endl;
+            throw std::runtime_error("replay: keyframe reference missing");
+        }
+    }
+
+    // ---------------- fixed train / held-out split ----------------------
+    // Held out every 8th keyframe. The split is decided from the exported
+    // keyframe index alone, so it is identical for every condition and every
+    // repeat; nothing is chosen per condition or per scene outcome.
+    std::vector<std::size_t> eval_idx, train_idx;
+    {
+        std::size_t n_hold = 0;
+        for (std::size_t i = 0; i < kfs.size(); ++i) {
+            if (i % 8 == 7) {
+                eval_idx.push_back(i);
+                ++n_hold;
+            }
+            else
+                train_idx.push_back(i);
+        }
+        if (eval_idx.empty()) {  // degenerate export: never happen, but be safe
+            for (std::size_t i = 0; i + 1 < kfs.size(); ++i)
+                train_idx.push_back(i);
+            eval_idx.push_back(kfs.size() - 1);
+        }
+        std::cerr << "[Replay] keyframes=" << kfs.size()
+                  << " train=" << train_idx.size()
+                  << " held_out=" << n_hold << std::endl;
+    }
+
+    // ---------------- decode the common images once --------------------
+    for (const auto &k : kfs) {
+        cv::Mat rgb, aux;
+        if (!readKfImages(replay_dir_, k, rgb, aux)) {
+            std::cerr << "[Replay] FATAL: image missing for kf " << k.fid
+                      << std::endl;
+            throw std::runtime_error("replay: image missing");
+        }
+        replay_image_cache_[k.fid] = {rgb, aux};
+    }
+    std::cerr << "[Replay] decoded " << replay_image_cache_.size()
+              << " keyframe image pairs from the export" << std::endl;
+
+    // ---------------- coordinate frames --------------------------------
+    if (snap.coord_epoch != 0)
+        std::cerr << "[Replay] WARNING: source run changed the world frame "
+                  << snap.coord_epoch
+                  << " time(s); the events carry those transforms, the "
+                     "evaluation poses follow the same per-keyframe updates."
+                  << std::endl;
+
+    // ---------------- schedule the events on the step axis --------------
+    // Length of the live run on the mapper iteration axis: every recorded
+    // iteration (event time AND keyframe birth time) is rescaled onto [0,
+    // replay_steps_] with this one number, so both keep their relative
+    // position in the optimisation budget.
+    long long nat = std::max<long long>(1, snap.natural_iter);
+    {
+        std::ifstream meta(replay_dir_ / "run_meta.txt");
+        std::string line;
+        while (std::getline(meta, line)) {
+            if (line.rfind("total_iteration=", 0) == 0)
+                nat = std::max<long long>(1, std::atoll(line.c_str() + 16));
+        }
+        std::cerr << "[Replay] event axis length (live iterations) = " << nat
+                  << " -> replay steps " << replay_steps_ << std::endl;
+        long long prev = 1;
+        for (auto &e : events) {
+            long long s = static_cast<long long>(
+                std::llround(static_cast<double>(e.iteration) *
+                             static_cast<double>(replay_steps_) /
+                             static_cast<double>(nat)));
+            if (s < 1)
+                s = 1;
+            if (s > replay_steps_)
+                s = replay_steps_;
+            if (s < prev)
+                s = prev;  // preserve the recorded order
+            prev = s;
+            e.replay_step = s;
+        }
+    }
+    std::vector<std::vector<std::size_t>> events_at(replay_steps_ + 2);
+    for (std::size_t i = 0; i < events.size(); ++i) {
+        const auto st = static_cast<std::size_t>(events[i].replay_step);
+        events_at[st].push_back(i);
+    }
+
+    // ---------------- condition list ------------------------------------
+    struct Cond { std::string tag; int v; int n; };
+    std::vector<Cond> conds;
+    {
+        std::string list = replayEnvStr("PHOTO_SLAM_REPLAY_CONDS");
+        if (list.empty())
+            list = "A,A_repeat,V,N,VN";
+        std::string item;
+        for (std::size_t i = 0; i <= list.size(); ++i) {
+            if (i < list.size() && list[i] != ',') {
+                item += list[i];
+                continue;
+            }
+            const auto b = item.find_first_not_of(" \t");
+            const auto e = item.find_last_not_of(" \t");
+            item = (b == std::string::npos) ? std::string() : item.substr(b, e - b + 1);
+            if (!item.empty()) {
+                if (item == "A")
+                    conds.push_back({"A", 0, 0});
+                else if (item == "A_repeat" || item == "Arep")
+                    conds.push_back({"A_repeat", 0, 0});
+                else if (item == "V")
+                    conds.push_back({"V", 1, 0});
+                else if (item == "N")
+                    conds.push_back({"N", 0, 1});
+                else if (item == "VN")
+                    conds.push_back({"VN", 1, 1});
+                else
+                    std::cerr << "[Replay] unknown condition '" << item
+                              << "' - skipped" << std::endl;
+            }
+            item.clear();
+        }
+    }
+    if (conds.empty()) {
+        std::cerr << "[Replay] no conditions - aborting" << std::endl;
+        return;
+    }
+    {
+        int rot = 0;
+        if (const char *r = std::getenv("PHOTO_SLAM_REPLAY_ROTATE"))
+            rot = std::atoi(r);
+        const int n = static_cast<int>(conds.size());
+        rot = ((rot % n) + n) % n;
+        std::rotate(conds.begin(), conds.begin() + rot, conds.end());
+        std::string names;
+        for (const auto &c : conds)
+            names += c.tag + " ";
+        std::cerr << "[Replay] condition order: " << names
+                  << "(rotation " << rot << ")" << std::endl;
+    }
+
+    const int sh_init = default_sh_;
+    const std::filesystem::path base_result_dir = result_dir_;
+    const auto loop_start = std::chrono::steady_clock::now();
+
+    for (const auto &cond : conds) {
+        std::cerr << "\n[Replay] ===== condition " << cond.tag << " (V="
+                  << cond.v << " N=" << cond.n << ") =====" << std::endl;
+
+        // ---- 1. switches: set the value the code will actually read -------
+        ORB_SLAM3::DedupVoxelOverrideSlot() = cond.v;
+        ORB_SLAM3::DedupNotifyOverrideSlot() = cond.n;
+        const bool v_on = ORB_SLAM3::DedupVoxelLive();
+        const bool n_on = ORB_SLAM3::DedupNotifyEnabled();
+        if (v_on != (cond.v != 0) || n_on != (cond.n != 0)) {
+            std::cerr << "[Replay] FATAL: switch did not take effect" << std::endl;
+            throw std::runtime_error("replay: switch not applied");
+        }
+
+        const auto cond_dir = base_result_dir / cond.tag;
+        std::filesystem::create_directories(cond_dir);
+
+        // ---- 2. rebuild the scene from the exported files -----------------
+        scene_->keyframes().clear();
+        scene_->cached_point_cloud_ = snap.pcd;
+        scene_->cameras_extent_ = snap.extent;
+        scene_->invalidateVoxelGrid("replay-init");
+        scene_->resetVoxelStats();
+        if (!v_on) {
+            // Legacy semantics: the grid is seeded from the initial line
+            // samples and never invalidated afterwards, exactly as the live
+            // V=0 path does during the initial mapping round.
+            for (const auto &kv : snap.pcd)
+                if (kv.second.source_ == PointSourceType::LINE_SAMPLED)
+                    scene_->addPointToVoxel(kv.second.xyz_.cast<float>(),
+                                            opt_params_.voxel_size_);
+        }
+
+        for (const auto &rec : kfs) {
+            auto cached = replay_image_cache_.at(rec.fid);
+            auto pkf = std::make_shared<GaussianKeyframeLine>(
+                rec.fid, 0 /* born at replay step 0 in this harness */);
+            pkf->zfar_ = z_far_;
+            pkf->znear_ = z_near_;
+            Sophus::SE3f pose;
+            pose.setQuaternion(
+                Eigen::Quaternionf(rec.q[0], rec.q[1], rec.q[2], rec.q[3])
+                    .normalized());
+            pose.translation() = Eigen::Vector3f(rec.t[0], rec.t[1], rec.t[2]);
+            pkf->setPose(pose.unit_quaternion().cast<double>(),
+                         pose.translation().cast<double>());
+            Camera &camera = scene_->cameras_.at(rec.camera_id);
+            pkf->setCameraParams(camera);
+            pkf->original_image_ =
+                tensor_utils::cvMat2TorchTensor_Float32(cached.first, device_type_);
+            pkf->img_filename_ = rec.name;
+            pkf->gaus_pyramid_height_ = camera.gaus_pyramid_height_;
+            pkf->gaus_pyramid_width_ = camera.gaus_pyramid_width_;
+            pkf->gaus_pyramid_times_of_use_ = kf_gaus_pyramid_times_of_use_;
+            pkf->img_undist_ = cached.first;
+            pkf->img_auxiliary_undist_ = cached.second;
+            pkf->computeTransformTensors();
+            // The stability gate in scaledTransformVisiblePointsOfKeyframe()
+            // compares gaussian ages against the keyframe's birth iteration.
+            // Map the recorded birth iteration onto the replay step axis so the
+            // relative relation (and therefore which gaussians count as
+            // "already stable") is preserved instead of all-instant.
+            pkf->creation_iter_ = static_cast<int>(std::llround(
+                static_cast<double>(rec.creation_iter) *
+                static_cast<double>(replay_steps_) / static_cast<double>(nat)));
+            pkf->remaining_times_of_use_ = 1000;
+            scene_->addKeyframe(pkf, &kfid_shuffled_);
+
+            // Pyramid tensors, same construction as the live path.
+            if (device_type_ == torch::kCUDA) {
+                cv::cuda::GpuMat img_gpu;
+                img_gpu.upload(pkf->img_undist_);
+                pkf->gaus_pyramid_original_image_.resize(num_gaus_pyramid_sub_levels_);
+                for (int l = 0; l < num_gaus_pyramid_sub_levels_; ++l) {
+                    cv::cuda::GpuMat img_resized;
+                    cv::cuda::resize(img_gpu, img_resized,
+                                     cv::Size(pkf->gaus_pyramid_width_[l],
+                                              pkf->gaus_pyramid_height_[l]));
+                    pkf->gaus_pyramid_original_image_[l] =
+                        tensor_utils::cvGpuMat2TorchTensor_Float32(img_resized);
+                }
+            }
+            else {
+                pkf->gaus_pyramid_original_image_.resize(num_gaus_pyramid_sub_levels_);
+                for (int l = 0; l < num_gaus_pyramid_sub_levels_; ++l) {
+                    cv::Mat img_resized;
+                    cv::resize(pkf->img_undist_, img_resized,
+                               cv::Size(pkf->gaus_pyramid_width_[l],
+                                        pkf->gaus_pyramid_height_[l]));
+                    pkf->gaus_pyramid_original_image_[l] =
+                        tensor_utils::cvMat2TorchTensor_Float32(img_resized, device_type_);
+                }
+            }
+        }
+
+        // ---- 3. fresh model + fresh Adam state ---------------------------
+        gaussians_.reset();
+        gaussians_ = std::make_shared<GaussianModelLine>(model_params_);
+        gaussians_->createFromPcd(scene_->cached_point_cloud_, scene_->cameras_extent_);
+        gaussians_->trainingSetup(opt_params_);
+        const long long n_init = gaussians_->xyz_.size(0);
+        const long long n_init_line = gaussians_->is_line_.defined()
+                                          ? gaussians_->is_line_.sum().item<int64_t>()
+                                          : 0;
+
+        // ---- 4. reset every counter / RNG that the loop depends on -------
+        iteration_ = 0;
+        frozen_opt_steps_ = 0;
+        frozen_kf_replay_ = true;
+        frozen_kf_step_ = 0;
+        default_sh_ = sh_init;
+        total_training_time_ms_ = 0.0;
+        ema_loss_for_log_ = 0.0;
+        kfs_used_times_.clear();
+        kfid_shuffled_ = false;
+        shuffle_counter_ = 0;
+        last_consumer_ = {};
+        replay_event_stats_.clear();
+
+        // Fixed keyframe sampling sequence: a seeded shuffle of the TRAINING
+        // keyframes only (held-out views are never shown), repeated until the
+        // step budget is filled. Identical for all conditions.
+        {
+            frozen_kf_seq_.clear();
+            int seq_seed = 12345;
+            if (const char *e = std::getenv("PHOTO_SLAM_REPLAY_SEQ_SEED"))
+                seq_seed = std::atoi(e);
+            if (random_seed_ >= 0)
+                seq_seed += random_seed_;
+            std::mt19937 gen(static_cast<unsigned>(seq_seed));
+            std::vector<std::size_t> pool = train_idx;
+            while (static_cast<int>(frozen_kf_seq_.size()) < replay_steps_) {
+                std::shuffle(pool.begin(), pool.end(), gen);
+                for (std::size_t v : pool) {
+                    if (static_cast<int>(frozen_kf_seq_.size()) >= replay_steps_)
+                        break;
+                    frozen_kf_seq_.push_back(v);
+                }
+            }
+            std::srand(static_cast<unsigned>(seq_seed));
+            std::cerr << "[Replay][" << cond.tag << "] kf sequence steps="
+                      << frozen_kf_seq_.size() << " seed=" << seq_seed
+                      << " hash=" << psl_replay::hashHex(
+                             [&] {
+                                 std::string s;
+                                 for (auto v : frozen_kf_seq_)
+                                     s += std::to_string(v) + ",";
+                                 return s;
+                             }())
+                      << std::endl;
+        }
+
+        result_dir_ = cond_dir;
+
+        // ---- 5. step loop ------------------------------------------------
+        std::ofstream steps_csv(cond_dir / "steps.csv");
+        steps_csv << "condition,v,n,step,psnr_heldout,ssim_heldout,psnr_train,"
+                     "ssim_train,gaussians,gaussians_point,gaussians_line,"
+                     "cum_mapping_ms,eval_ms,is_key_event,event_seq\n";
+
+        const auto loop_t0 = std::chrono::steady_clock::now();
+
+        auto evalOnce = [&](long long step, const char *tag_kind, int ev_seq) {
+            const auto t_eval0 = std::chrono::steady_clock::now();
+            double p = -1.0, s = -1.0, pt = -1.0, st_ = -1.0;
+            std::ostringstream rows;
+            rows << "fid,psnr,ssim\n";
+            replayEvaluate(eval_idx, p, s, &rows);
+            std::ostringstream rows_t;
+            rows_t << "fid,psnr,ssim\n";
+            replayEvaluate(train_idx, pt, st_, &rows_t);
+            const double eval_ms =
+                std::chrono::duration_cast<std::chrono::microseconds>(
+                    std::chrono::steady_clock::now() - t_eval0)
+                    .count() / 1000.0;
+            const long long n_g = gaussians_->xyz_.size(0);
+            const long long n_l = gaussians_->is_line_.defined()
+                                      ? gaussians_->is_line_.sum().item<int64_t>()
+                                      : 0;
+            const double cum_ms =
+                std::chrono::duration_cast<std::chrono::microseconds>(
+                    std::chrono::steady_clock::now() - loop_t0)
+                    .count() / 1000.0 - eval_ms;
+            steps_csv << cond.tag << ',' << cond.v << ',' << cond.n << ',' << step
+                      << ',' << p << ',' << s << ',' << pt << ',' << st_ << ','
+                      << n_g << ',' << (n_g - n_l) << ',' << n_l << ',' << cum_ms
+                      << ',' << eval_ms << ',' << tag_kind << ',' << ev_seq << '\n';
+            steps_csv.flush();
+            std::ostringstream pv;
+            pv << cond.tag << "_step" << step << "_" << tag_kind;
+            std::ofstream(cond_dir / (pv.str() + "_heldout.csv")) << rows.str();
+            std::ofstream(cond_dir / (pv.str() + "_train.csv")) << rows_t.str();
+            std::cerr << "[Replay][" << cond.tag << "] step=" << step << " ("
+                      << tag_kind << ") psnr_heldout=" << p << " ssim=" << s
+                      << " psnr_train=" << pt << " gaussians=" << n_g
+                      << " line=" << n_l << " eval_ms=" << eval_ms << std::endl;
+        };
+
+        evalOnce(0, "init", 0);
+        // Initial un-optimised model: saved once per process. It is byte
+        // identical for every condition because they all start from the same
+        // pcd, so saving it five times would only waste disk.
+        if (cond.tag == conds.front().tag)
+            savePly(cond_dir / "init" / "ply");
+
+        for (long long step = 1; step <= replay_steps_; ++step) {
+            trainForOneIterationErrorGuided();
+
+            for (std::size_t ei : events_at[step]) {
+                ReplayEventStat st;
+                injectReplayEvent(events[ei], st, eval_idx, train_idx, cond_dir);
+                replay_event_stats_.push_back(st);
+            }
+
+            if (step == 100 || step == 500 || step == 1000 || step == 3000 ||
+                step == 5000 || step == replay_steps_)
+                evalOnce(step, "step", 0);
+        }
+
+        const double mapping_ms =
+            std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - loop_t0)
+                .count() / 1000.0;
+
+        // ---- 6. final state ---------------------------------------------
+        {
+            const long long n_g = gaussians_->xyz_.size(0);
+            const long long n_l = gaussians_->is_line_.defined()
+                                      ? gaussians_->is_line_.sum().item<int64_t>()
+                                      : 0;
+            const bool finite =
+                n_g == 0 || torch::isfinite(gaussians_->xyz_).all().item<bool>();
+            const auto vox = scene_->voxel_stats();
+            std::ofstream sum(cond_dir / "summary.txt");
+            sum << "condition=" << cond.tag << "\n"
+                << "v=" << cond.v << "\n"
+                << "n=" << cond.n << "\n"
+                << "v_effective=" << (v_on ? 1 : 0) << "\n"
+                << "n_effective=" << (n_on ? 1 : 0) << "\n"
+                << "input_snapshot_hash=" << snap.hash << "\n"
+                << "kf_sequence_hash="
+                << psl_replay::hashHex([&] {
+                       std::string s;
+                       for (auto v : frozen_kf_seq_) s += std::to_string(v) + ",";
+                       return s;
+                   }())
+                << "\n"
+                << "opt_steps=" << frozen_opt_steps_ << "\n"
+                << "requested_steps=" << replay_steps_ << "\n"
+                << "events_applied=" << replay_event_stats_.size() << "\n"
+                << "events_in_stream=" << events.size() << "\n"
+                << "gaussians_init=" << n_init << "\n"
+                << "gaussians_init_line=" << n_init_line << "\n"
+                << "gaussians_final=" << n_g << "\n"
+                << "gaussians_final_line=" << n_l << "\n"
+                << "finite=" << (finite ? 1 : 0) << "\n"
+                << "mapping_ms_incl_events_and_voxel=" << mapping_ms << "\n"
+                << "voxel_invalidations=" << vox.invalidations << "\n"
+                << "voxel_rebuilds=" << vox.rebuilds << "\n"
+                << "voxel_rebuild_points=" << vox.rebuild_points << "\n"
+                << "voxel_rebuild_ms=" << vox.rebuild_ms << "\n"
+                << "voxel_committed_keys=" << vox.committed_keys << "\n"
+                << "voxel_rejected_duplicates=" << vox.rejected_duplicates
+                << "\n";
+        }
+        writeReplayEventLog(cond_dir);
+        std::cerr << "[Replay][" << cond.tag << "] done: opt_steps="
+                  << frozen_opt_steps_ << " gaussians=" << gaussians_->xyz_.size(0)
+                  << " events=" << replay_event_stats_.size()
+                  << " mapping_ms=" << mapping_ms << std::endl;
+    }
+
+    ORB_SLAM3::DedupVoxelOverrideSlot() = -1;
+    ORB_SLAM3::DedupNotifyOverrideSlot() = -1;
+    replay_running_ = false;
+    result_dir_ = base_result_dir;
+    std::cerr << "[Replay] all conditions finished in "
+              << std::chrono::duration_cast<std::chrono::seconds>(
+                     std::chrono::steady_clock::now() - loop_start)
+                     .count()
+              << "s; output: " << replay_dir_.string() << std::endl;
+}
