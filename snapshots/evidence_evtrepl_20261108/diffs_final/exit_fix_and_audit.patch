+        Eigen::Matrix3f got_rot = quatToMat(rot1[i][0].item<float>(), rot1[i][1].item<float>(),
+                                            rot1[i][2].item<float>(), rot1[i][3].item<float>());
+        e_rot = std::max(e_rot, static_cast<double>((want_rot - got_rot).cwiseAbs().maxCoeff()));
+
+        for (int d = 0; d < 3; ++d) {
+            const double want_ls = static_cast<double>(sc0c[i][d].item<float>()) + std::log(s);
+            e_logs = std::max(e_logs, std::abs(want_ls - static_cast<double>(sc1[i][d].item<float>())));
+        }
+
+        if (has_anchor) {
+            Eigen::Vector3f a(anc0c[i][0].item<float>(), anc0c[i][1].item<float>(),
+                              anc0c[i][2].item<float>());
+            Eigen::Vector3f wa = s * (R * a) + t;
+            Eigen::Vector3f ga(model.xyz_init_[i][0].item<float>(),
+                               model.xyz_init_[i][1].item<float>(),
+                               model.xyz_init_[i][2].item<float>());
+            e_anc = std::max(e_anc, static_cast<double>((wa - ga).cwiseAbs().maxCoeff()));
+        }
+        if (has_dir) {
+            Eigen::Vector3f dv(dir0c[i][0].item<float>(), dir0c[i][1].item<float>(),
+                               dir0c[i][2].item<float>());
+            Eigen::Vector3f gd(model.line_dir_w_[i][0].item<float>(),
+                               model.line_dir_w_[i][1].item<float>(),
+                               model.line_dir_w_[i][2].item<float>());
+            // The consumer rotates line_dir_w_ ONLY for line-sampled Gaussians
+            // (line_mask = newly_transformed AND is_line_). For every other
+            // object the direction must be untouched, so the expectation differs
+            // by class and is checked that way instead of assuming a global
+            // rotation.
+            const bool is_line_i = model.is_line_.defined()
