 // ---------------------------------------------------------------------------
 
 namespace {
+
+// ===========================================================================
+// [EVT-AUDIT] Numerical audit of the PRODUCTION event chain.
+//
+// For every object the production consumer claims to have updated, this checks
+// the four fields it promises to move against the closed-form similarity
+// transform, using the exact (R, t, s) the kernel was given:
+//
+//   xyz'      = s * R * xyz + t          (kernel: M * (s p) + t)
+//   q'        = q_R (x) q                (kernel: R_new = M_R * R_old)
+//   log_sigma'= log_sigma + log(s)
+//   anchor'   = s * R * anchor + t       (coherence-loss anchor)
+//   dir'      = R * dir                  (line direction, world)
+//   Sigma'    = s^2 * R * Sigma * R^T    (checked on a sample)
+//
+// and that every object the consumer did NOT claim is bit-identical (the kernel
+// only writes the masked rows, so any difference there is a real defect).
+// It also reports the skip reasons and the mask sizes, so "the mechanism ran"
+// is replaced by "these objects, with these values, changed this much".
+// ===========================================================================
+bool evtAuditEnabled()
+{
+    static const bool v = []() {
+        const char* e = std::getenv("PHOTO_SLAM_EVT_AUDIT");
+        return e && std::atoi(e) != 0;
+    }();
+    return v;
+}
+int evtAuditMaxKfs()
+{
+    static const int v = []() {
+        const char* e = std::getenv("PHOTO_SLAM_EVT_AUDIT_KFS");
+        return e ? std::atoi(e) : 3;
+    }();
+    return v;
+}
+int evtAuditMaxSamples()
+{
+    static const int v = []() {
+        const char* e = std::getenv("PHOTO_SLAM_EVT_AUDIT_SAMPLES");
+        return e ? std::atoi(e) : 64;
+    }();
+    return v;
+}
+// How many keyframes may be audited. The budget is only consumed when a
+// keyframe actually moved something, so "the first N keyframes happened to be
+// below the age gate" cannot silently produce an empty audit.
+int evtAuditAttemptsLeft()
+{
+    static int left = 200;
+    return left > 0 ? --left : 0;
+}
+int evtAuditAudited()
+{
+    static int n = 0;
+    return n < evtAuditMaxKfs() ? n : -1;   // -1 = budget exhausted
+}
+void evtAuditCountOne()
+{
+    static int n = 0;
+    ++n;
+}
