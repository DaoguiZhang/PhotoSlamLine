+void GaussianMapperLine::evtAuditKfInto(
+    EventAuditTotals& totals,
+    GaussianModelLine& model,
+    const torch::Tensor& xyz0,
+    const torch::Tensor& sc0,
+    const torch::Tensor& rot0,
+    const torch::Tensor& anchor0,
+    const torch::Tensor& dir0,
+    const torch::Tensor& flags_before,
+    const torch::Tensor& flags_after,
+    const Eigen::Matrix3f& R,
+    const Eigen::Vector3f& t,
+    const float scale,
+    const unsigned long kfid,
+    const char* tag)
+{
+    if (xyz0.size(0) != model.xyz_.size(0) || flags_before.size(0) != xyz0.size(0)) {
+        std::cerr << "[EvtAudit] shape mismatch - skipped (model grew during the "
+                     "call)\n";
+        return;
+    }
+    const double s = static_cast<double>(scale);
+    auto xyz1 = cpuF32(model.xyz_);
+    auto sc1 = cpuF32(model.scaling_);
+    auto rot1 = cpuF32(model.rotation_);
+    auto a0 = cpuF32(xyz0);
+    auto b0 = cpuF32(flags_before);
+    torch::Tensor newly = b0.logical_and(flags_after.detach().to(torch::kCPU).logical_not());
+    const long long n_new = newly.sum().item<int64_t>();
+    const long long n_tot = xyz0.size(0);
+
+    // 1. objects the consumer did not claim must be bit-identical
+    {
+        torch::Tensor stay = newly.logical_not();
+        auto d = std::get<0>((xyz1 - a0).abs().max(/*dim=*/1));
+        double worst = 0.0;
+        if (stay.any().item<bool>())
+            worst = d.masked_select(stay).max().item<double>();
+        if (worst > 0.0)
+            ++totals.changed_not_transformed;
+        totals.max_changed_not_transformed =
+            std::max(totals.max_changed_not_transformed, worst);
+    }
+
+    // 2. sampled transformed objects, field by field
+    const int n_sample =
+        static_cast<int>(std::min<long long>(n_new, evtAuditMaxSamples()));
+    if (n_sample <= 0) {
+        std::cerr << "[EvtAudit] tag=" << tag << " kf=" << kfid
+                  << " nTotal=" << n_tot << " newlyTransformed=0 (below the age "
+                     "gate for this keyframe; budget not consumed)\n";
+        return;
+    }
+    evtAuditCountOne();
+    torch::Tensor idx = newly.nonzero().to(torch::kCPU).to(torch::kLong).view(-1);
+    auto sc0c = cpuF32(sc0);
+    auto rot0c = cpuF32(rot0);
+    double e_xyz = 0, e_rot = 0, e_logs = 0, e_anc = 0, e_dir = 0, e_sig = 0;
+    // Attribution of the worst covariance error: a large maxErrSigma is useless
+    // for diagnosis unless we can name the object and its log-scales.
+    long long sig_i = -1;
+    float sig_ls0[3] = {0.f, 0.f, 0.f}, sig_ls1[3] = {0.f, 0.f, 0.f};
+    long long n_line_checked = 0;
+    const bool has_anchor = anchor0.defined() && anchor0.size(0) == xyz0.size(0);
+    const bool has_dir = dir0.defined() && dir0.size(0) == xyz0.size(0);
+    torch::Tensor anc0c, dir0c;
+    if (has_anchor) anc0c = cpuF32(anchor0);
+    if (has_dir) dir0c = cpuF32(dir0);
+
+    for (int k = 0; k < n_sample; ++k) {
+        const long long i = idx[k].item<int64_t>();
+        Eigen::Vector3f p(a0[i][0].item<float>(), a0[i][1].item<float>(),
+                          a0[i][2].item<float>());
+        Eigen::Vector3f want = s * (R * p) + t;
+        Eigen::Vector3f got(xyz1[i][0].item<float>(), xyz1[i][1].item<float>(),
+                            xyz1[i][2].item<float>());
+        e_xyz = std::max(e_xyz, static_cast<double>((want - got).cwiseAbs().maxCoeff()));
