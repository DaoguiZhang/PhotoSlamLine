+    ++totals.events_marked;
+    ++totals.kfs;
+    totals.objects_checked += n_sample;
+    totals.max_xyz = std::max(totals.max_xyz, e_xyz);
+    totals.max_rot = std::max(totals.max_rot, e_rot);
+    totals.max_logscale = std::max(totals.max_logscale, e_logs);
+    totals.max_anchor = std::max(totals.max_anchor, e_anc);
+    totals.max_dir = std::max(totals.max_dir, e_dir);
+    totals.max_sigma = std::max(totals.max_sigma, e_sig);
+    totals.newly_transformed += n_new;
