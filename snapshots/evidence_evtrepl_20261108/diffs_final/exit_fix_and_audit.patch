+            e_dir = std::max(e_dir,
+                             static_cast<double>((want_dir - gd).cwiseAbs().maxCoeff()));
+            if (is_line_i)
+                ++n_line_checked;
+        }
+
+        if (k < 8) {
+            // covariance: Sigma = Rq diag(exp(log_sigma)^2) Rq^T
+            // NOTE: the squared vector and the diagonal matrix are materialised
+            // into named objects on purpose. Passing `d.cwiseAbs2()` (a lazy
+            // expression) straight into asDiagonal() let the wrapper outlive the
+            // temporary it referenced, which produced garbage (inf / ~1e37) in an
+            // earlier version of this audit. Keep it materialised.
+            auto cov = [](const Eigen::Matrix3f& Rq, const Eigen::Vector3f& ls) {
+                Eigen::Vector3f d(std::exp(ls[0]), std::exp(ls[1]), std::exp(ls[2]));
+                Eigen::Vector3f d2 = d.cwiseAbs2();
+                Eigen::Matrix3f D = d2.asDiagonal();
+                return Eigen::Matrix3f(Rq * D * Rq.transpose());
+            };
+            Eigen::Vector3f ls0(sc0c[i][0].item<float>(), sc0c[i][1].item<float>(),
+                                sc0c[i][2].item<float>());
+            Eigen::Vector3f ls1(sc1[i][0].item<float>(), sc1[i][1].item<float>(),
+                                sc1[i][2].item<float>());
+            Eigen::Matrix3f S0 = cov(q0m, ls0);
+            Eigen::Matrix3f want_S = (s * s) * R * S0 * R.transpose();
+            Eigen::Matrix3f got_S = cov(got_rot, ls1);
+            const double e_here =
+                static_cast<double>((want_S - got_S).cwiseAbs().maxCoeff());
+            if (e_here > e_sig) {
+                e_sig = e_here;
+                sig_i = i;
+                for (int d = 0; d < 3; ++d) {
+                    sig_ls0[d] = ls0[d];
+                    sig_ls1[d] = ls1[d];
+                }
+            }
+        }
+    }
