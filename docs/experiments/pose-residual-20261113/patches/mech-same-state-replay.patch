+int Optimizer::PoseOptimizationWithLine(Frame *pFrame)
+{
+    if (g_poMechFrame == -2) g_poMechFrame = PoFrameEnv("PHOTO_SLAM_PO_MECH");
+    const Sophus::SE3<float> TcwIn = pFrame->GetPose();
+    const std::vector<bool> outIn = pFrame->mvbOutlier;
+    const std::vector<bool> lnIn = pFrame->mvbLineOutlier;
+
+    const int envPolicy = CurPoPolicy();
+    const int nMain = PoseOptimizationWithLineOnce(pFrame);
+    const Sophus::SE3<float> TcwEnv = pFrame->GetPose();
+    int ptOutEnv = 0, lnOutEnv = 0;
+    for (size_t i = 0; i < pFrame->mvbOutlier.size(); ++i) ptOutEnv += pFrame->mvbOutlier[i];
+    for (size_t i = 0; i < pFrame->mvbLineOutlier.size(); ++i) lnOutEnv += pFrame->mvbLineOutlier[i];
+    const int reAdmitPtEnv = g_poReAdmitPt, reAdmitLnEnv = g_poReAdmitLn;
+    const int nanPtEnv = g_poNaNPt, nanLnEnv = g_poNaNLn, stuckEnv = g_poStuckHits;
+
+    const bool mech = (g_poMechFrame == -1 || g_poMechFrame == (int)pFrame->mnId);
+    if (mech)
+    {
+        std::cerr << "[PoMech] frame=" << pFrame->mnId << " policy=" << PoPolicyName(envPolicy)
+                  << " nRet=" << nMain
+                  << " t=" << TcwEnv.translation().x() << "," << TcwEnv.translation().y()
+                  << "," << TcwEnv.translation().z()
+                  << " ptOut=" << ptOutEnv << " lnOut=" << lnOutEnv
+                  << " reAdmitPt=" << reAdmitPtEnv << " reAdmitLn=" << reAdmitLnEnv
+                  << " nanPt=" << nanPtEnv << " nanLn=" << nanLnEnv
+                  << " stuck=" << stuckEnv << std::endl;
+        for (int p = PO_PRE; p <= PO_STICKY; ++p)
+        {
+            if (p == envPolicy) continue;
+            pFrame->SetPose(TcwIn);
+            pFrame->mvbOutlier = outIn;
+            pFrame->mvbLineOutlier = lnIn;
+            g_poPolicy = p;
+            const int n = PoseOptimizationWithLineOnce(pFrame);
+            const Sophus::SE3<float> T = pFrame->GetPose();
+            int ptOut = 0, lnOut = 0;
+            for (size_t i = 0; i < pFrame->mvbOutlier.size(); ++i) ptOut += pFrame->mvbOutlier[i];
+            for (size_t i = 0; i < pFrame->mvbLineOutlier.size(); ++i) lnOut += pFrame->mvbLineOutlier[i];
+            std::cerr << "[PoMech] frame=" << pFrame->mnId << " policy=" << PoPolicyName(p)
+                      << " nRet=" << n
+                      << " t=" << T.translation().x() << "," << T.translation().y()
+                      << "," << T.translation().z()
+                      << " ptOut=" << ptOut << " lnOut=" << lnOut
+                      << " reAdmitPt=" << g_poReAdmitPt << " reAdmitLn=" << g_poReAdmitLn
+                      << " nanPt=" << g_poNaNPt << " nanLn=" << g_poNaNLn
+                      << " stuck=" << g_poStuckHits << std::endl;
+        }
+        // replay the environment policy from the ORIGINAL state so the rest of
+        // tracking continues exactly as it would have without the experiment
+        pFrame->SetPose(TcwIn);
+        pFrame->mvbOutlier = outIn;
+        pFrame->mvbLineOutlier = lnIn;
+        g_poPolicy = envPolicy;
+        PoseOptimizationWithLineOnce(pFrame);
+        g_poReAdmitPt = reAdmitPtEnv; g_poReAdmitLn = reAdmitLnEnv;
+        g_poNaNPt = nanPtEnv; g_poNaNLn = nanLnEnv; g_poStuckHits = stuckEnv;
+    }
+    return nMain;
+}
